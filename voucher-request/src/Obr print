            <div class="ln"><span>Date:</span><i></i></div>
          </div>
        </div>
      </td>
      <td class="bx" style="height:100px">
        <div class="hd"><span class="let">E</span><span class="t"><strong>Received Payment:</strong></span></div>
      </td>
