<style>
  /* =====================================================================
     OBR MODULE: Obligation Request + Disbursement Voucher (print layouts)
     ===================================================================== */
  #printArea, #printDv { display: none; }

  .print-sub { color: #6b7f72; font-size: 16px; margin-bottom: 16px; }
  .print-choice { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .print-opt { border: 1px solid var(--g-200); background: var(--g-50); border-radius: 14px; padding: 20px 12px; text-align: center; cursor: pointer; transition: all .15s; font-family: inherit; color: #24352a; }
  .print-opt:hover, .print-opt:focus-visible { border-color: var(--g-500); background: var(--g-100); transform: translateY(-2px); box-shadow: 0 4px 12px rgba(61,154,90,.18); outline: none; }
  .print-opt .ico { width: 44px; height: 44px; margin: 0 auto 10px; border-radius: 12px; background: var(--g-600); color: #fff; display: flex; align-items: center; justify-content: center; }
  .print-opt strong { display: block; font-size: 15px; color: var(--g-900); }
  .print-opt small { display: block; margin-top: 4px; font-size: 12px; color: #6b7f72; }
  @media (max-width: 480px) { .print-choice { grid-template-columns: 1fr; } }

  /* ---------- Printable ObR form ---------- */
  .obr .item td.part { text-indent: 28px; }
  .obr { width: 100%; max-width: 780px; margin: 0 auto; border-collapse: collapse; table-layout: fixed; font-size: 12px; color: #000; background: #fff; }
  .obr td, .obr th { border: 1px solid #000; padding: 3px 6px; vertical-align: top; overflow-wrap: anywhere; word-break: break-word; }
  .obr .head { text-align: center; border: 1px solid #000; padding: 6px; font-size: 14px; }
  .obr .head strong { font-size: 17px; }
  .obr .head-wrap { position: relative; min-height: 64px; display: flex; align-items: center; justify-content: center; }
  .obr .split-seal { position: absolute; left: 70px; top: 50%; transform: translateY(-50%); height: 64px; width: 64px; object-fit: contain; }
  .obr .center { text-align: center; }
  .obr .right { text-align: right; }
  .obr .lbl { width: 90px; }
  .obr .item td { border-top: 0; border-bottom: 0; }
  .obr .pre { white-space: pre-wrap; }
  .obr .obr-title { text-align: center; vertical-align: middle; font-size: 22px; font-weight: bold; height: 48px; letter-spacing: .5px; }
  .obr .obr-no { vertical-align: middle; font-size: 12px; }
  .obr .item td.bot { vertical-align: bottom; }
  #p_payee { font-weight: bold; }

  /* Certification / signature block */
  .obr.cert { margin-top: -1px; }
  .obr .cb { padding: 0; }
  .cert .top { height: 150px; }
  .cert .hd { display: flex; align-items: stretch; height: 24px; font-size: 13px; }
  .cert .hd .let { width: 26px; border-right: 1px solid #000; border-bottom: 1px solid #000; display: flex; align-items: center; justify-content: center; margin-right: 10px; }
  .cert .hd strong { display: flex; align-items: center; }
  .cert .chk { display: flex; align-items: flex-start; gap: 12px; margin: 16px 0 0 10%; }
  .cert .sq { flex: none; width: 22px; height: 22px; border: 1px solid #000; }
  .cert .txt { line-height: 16px; padding-top: 3px; }
  .cert .ex { margin: 16px 6px 0; line-height: 16px; padding-top: 3px; }
  .cert .lb { white-space: nowrap; }
  .cert .r-sig td, .cert .r-date td { height: 26px; }
  .cert .r-name td { height: 40px; }
  .cert .nm { text-align: left; vertical-align: bottom; font-weight: bold; }
  .cert .r-title td { height: 18px; padding-top: 1px; padding-bottom: 1px; }
  .cert .sm { font-size: 9px; vertical-align: middle; }

  /* ---------- Printable Disbursement Voucher ---------- */
  .dv .item td.part { text-indent: 28px; }
  .dv { width: 100%; max-width: 780px; margin: 0 auto; border-collapse: collapse; font-size: 12px; color: #000; background: #fff; table-layout: fixed; }
  .dv + .dv { margin-top: -1px; }
  .dv td { border: 1px solid #000; padding: 4px 6px; vertical-align: top; }
  .dv .c { text-align: center; }
  .dv .r { text-align: right; }

  .dv .ttl { font-family: Arial, sans-serif; font-weight: 800; font-size: 28px; letter-spacing: .5px; text-align: center; padding-top: 10px; }
  .dv .agency { font-family: "Times New Roman", serif; font-weight: bold; font-size: 18px; text-decoration: underline; text-align: center; padding-top: 14px; }
  .dv .lgu { font-style: italic; text-align: center; font-size: 11px; }
  .dv-annex { width: 100%; max-width: 780px; margin: 0 auto; display: flex; font-size: 12px; font-weight: bold; color: #000; }
  .dv-annex span { width: 28%; margin-left: auto; text-align: center; padding-bottom: 3px; }

  .dv .cls-h { font-weight: 800; font-style: italic; font-size: 16px; text-align: center; border-bottom: 0; padding-top: 8px; }
  .dv .cls-row { border-top: 0; height: 52px; }
  .dv .cls-wrap { display: flex; justify-content: space-around; align-items: center; height: 100%; }
  .dv .cls-it { display: flex; align-items: center; gap: 14px; font-size: 12px; }
  .dv .cbx { width: 30px; height: 26px; border: 1px solid #000; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; font-weight: bold; }

  .dv .field { height: 52px; }
  .dv .field .val { display: block; word-break: break-word; text-indent: 28px; }
  .dv .val { font-weight: bold; white-space: pre-wrap; overflow-wrap: anywhere; }
  .dv .ph { font-weight: 800; letter-spacing: 3px; text-align: center; font-size: 13px; padding: 5px; }
  .dv .item td { border-top: 0; border-bottom: 0; }
  .dv .pre { white-space: pre-wrap; overflow-wrap: anywhere; }
  .dv .due td { height: 46px; vertical-align: middle; }
  .dv .arrow { font-size: 26px; color: #4472c4; vertical-align: middle; margin: 0 16px 0 14px; }
  .dv .item td.bot { vertical-align: bottom; }

  .dv .nm { font-weight: bold; text-align: center; }
  .dv .bx { padding: 0; position: relative; }
  .dv .bx .hd { display: flex; align-items: stretch; height: 22px; font-size: 12px; }
  .dv .bx .let { width: 22px; border-right: 1px solid #000; border-bottom: 1px solid #000; display: flex; align-items: center; justify-content: center; margin-right: 6px; font-weight: bold; }
  .dv .bx .hd span.t { display: flex; align-items: center; }
  .dv .bx .txt { font-size: 10px; padding: 8px 12px 0 18px; line-height: 1.4; }
  .dv .bx.t1 { height: 120px; border-bottom: 0; }

  .dv .pos { height: 26px; vertical-align: bottom; text-align: center; border-top: 0; border-bottom: 0; font-size: 12px; }
  .dv .sgn { text-align: center; font-style: italic; font-size: 12px; height: 26px; vertical-align: middle; }

  .dv .gov { position: absolute; left: 0; right: 0; bottom: 3px; text-align: center; font-size: 12px; }
  .dv .sig2 { height: 70px; vertical-align: top; padding-top: 2px; }
  .dv .sig2 .jev { text-align: left; font-style: normal; margin-top: 22px; }
  .dv .jev { font-weight: bold; padding-top: 6px; }

  .dv .pay { padding: 9.5px 8px 0 6px; font-size: 12px; }
  .dv .pay .wrap { display: flex; align-items: center; }
  .dv .pay .arrow { flex: none; margin: 0 6px 0 0; font-size: 22px; }
  .dv .pay .ln { display: flex; gap: 4px; margin: 6px 0 0 0; align-items: flex-end; }
  .dv .pay .ln i { flex: 1; border-bottom: 1px solid #000; min-height: 14px; }

  @media print {
    body.mode-obr #printArea { display: block; width: 100%; padding: 8mm 12mm; box-sizing: border-box; }
    body.mode-obr #printArea .obr { break-inside: avoid; page-break-inside: avoid; }
    body.mode-obr #printArea .obr tr { break-inside: avoid; page-break-inside: avoid; }
    .cert .top { height: 120px; }
    body.mode-dv #printDv { display: block; width: 100%; padding: 8mm 12mm; box-sizing: border-box; }
  }
</style>

<div id="printArea">
  <table class="obr">
    <colgroup><col style="width:11%"><col style="width:54%"><col style="width:7%"><col style="width:13%"><col style="width:15%"></colgroup>
    <tr><td colspan="5" class="head">
      <div class="head-wrap">
        <img id="p_logo" class="split-seal" src="https://lh3.googleusercontent.com/u/0/d/106xJa9wP8qu72xcSWOrpkewrrjivhNXk" alt="PGO" referrerpolicy="no-referrer">
